# Copy to .env and fill in. Never commit .env. Placeholders only here.
# Used by later specs (LLM layer, serverless endpoint). The emulator does not read them.

# Primary provider: gemini | mistral | groq (fallback order is set in code)
LLM_PROVIDER=gemini

GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# Model names live in config because free-tier availability changes
GEMINI_MODEL=
MISTRAL_MODEL=
GROQ_MODEL=

# Rate limits
DAILY_CAP_PER_VISITOR=3
DAILY_CAP_GLOBAL=
