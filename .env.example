# Copy to .env and fill in. Never commit .env. Placeholders only here.
# Server-side only: these are read by src/llm (see src/llm/config.ts). Never ship them to the browser.
# Check your keys locally with: npm run llm:try
# Primary provider: gemini | mistral | groq. The others follow in the order gemini, mistral, groq.
# A provider with no key is skipped. If every real provider fails or is keyless,
# an offline mock stand-in (src/llm/mock.ts) serves instead. It is flagged offline and labeled "offline stand-in,
# not generated just now". Only if even the mock fails does generate() raise "The ghost is resting. Try the gallery."
LLM_PROVIDER=gemini
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
# Model names live in config because free-tier availability changes. Required for any provider
# that has a key. Suggested starting points (check each vendor's current free-tier list):
GEMINI_MODEL=gemini-2.5-flash
MISTRAL_MODEL=mistral-small-latest
GROQ_MODEL=llama-3.3-70b-versatile
# Rate limits
DAILY_CAP_PER_VISITOR=3
DAILY_CAP_GLOBAL=
